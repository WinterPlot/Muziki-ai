<?xml version="1.0" encoding="utf-8"?>
<!--
    "Frosted glass" current-tab indicator.

    The old version was a single flat #FF4081 pink block, which read as
    heavy/empty against the tab icons and label sitting on top of it.
    This version fakes a soft frosted-glass card instead: a faint drop
    shadow, a translucent near-white fill (so the tab bar's light gray
    track still shows through slightly, like blurred glass), and a thin
    pink-tinted hairline border to keep a clear accent identity without
    covering the tab in solid color.

    True background blur (RenderEffect) needs API 31+, so this uses a
    layered translucency trick instead - it looks clean and "frosted" at
    every API level this app supports, with no extra dependencies.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Soft shadow, offset slightly down to lift the pill off the track -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#14000000" />
            <corners android:radius="999dp" />
        </shape>
    </item>

    <!-- Frosted glass body -->
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#F2FFFFFF" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="#33FF4081" />
        </shape>
    </item>
</layer-list>
