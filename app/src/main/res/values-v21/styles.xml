<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="muziki_background">#0B0B10</color>
    <color name="muziki_surface">#15151D</color>
    <color name="muziki_surface_raised">#1D1D28</color>
    <color name="muziki_primary">#FF4081</color>
    <color name="muziki_primary_dark">#E91E63</color>
    <color name="muziki_on_surface">#F7F7FA</color>
    <color name="muziki_on_surface_muted">#A7A7B3</color>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorAccent">@color/muziki_primary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/muziki_background</item>
        <item name="android:navigationBarColor">@color/muziki_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="MuzikiButton" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
    </style>

    <style name="MuzikiIconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
    </style>
</resources>
