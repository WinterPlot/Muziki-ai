<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/muziki_background">

    <LinearLayout
        android:id="@+id/playerContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="26dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="muziki"
                android:textColor="#FF4081"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:padding="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:contentDescription="Favorite"
                android:src="@drawable/ic_player_heart_outline" />
        </RelativeLayout>

        <!-- VINYL DISC PLAYER -->
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginBottom="18dp">

            <ImageView
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:src="@drawable/disc_shadow_bg" />

            <com.mayuto.dev.muziki.AudioVisualizerView
                android:id="@+id/audioVisualizer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:contentDescription="Real-time audio visualizer" />

            <ImageView
                android:id="@+id/imgVinylDisc"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_player_vinyl_disc"
                android:contentDescription="Album art disc" />

            <ImageView
                android:id="@+id/imgTonearm"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="top|right"
                android:layout_marginTop="-10dp"
                android:layout_marginRight="-14dp"
                android:src="@drawable/ic_player_tonearm"
                android:contentDescription="Tonearm" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No music playing"
            android:textColor="@color/muziki_on_surface"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <SeekBar
                android:id="@+id/musicSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="@color/muziki_primary"
                android:thumbTint="@color/muziki_primary"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingLeft="5dp"
                android:paddingRight="5dp">

                <TextView
                    android:id="@+id/txtCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@color/muziki_on_surface_muted"
                    android:textSize="12sp"
                    android:layout_alignParentLeft="true" />

                <TextView
                    android:id="@+id/txtTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@color/muziki_on_surface_muted"
                    android:textSize="12sp"
                    android:layout_alignParentRight="true" />
            </RelativeLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtNowPlayingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOW PLAYING"
            android:textColor="@color/muziki_on_surface_muted"
            android:letterSpacing="0.2"
            android:textSize="11sp"
            android:layout_marginBottom="22dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnShuffle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/shuffle"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:layout_marginRight="8dp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnPrev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/prev"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:layout_marginRight="8dp" />

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp">

                <ImageView
                    android:id="@+id/imgPlayRing"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/play_ring_bg" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/play"
                    android:background="@android:color/transparent"
                    android:scaleType="centerInside" />
            </FrameLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnNext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/next"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:layout_marginLeft="8dp" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnRepeat"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/repeat"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:layout_marginLeft="8dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="18dp">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnEqualizer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_equalizer_v2"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:tint="#757575" />
        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/imgSeekFeedback"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:alpha="0"
        android:src="@drawable/ic_forward_10"
        android:tint="#FF4081" />

</FrameLayout>
