<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="32dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/img_perm_shield"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/avd_perm_shield" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/perm_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:gravity="center"
            android:text="@string/perm_subtitle"
            android:textSize="13.5sp"
            android:textColor="#757575" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- Storage permission card -->
            <LinearLayout
                android:id="@+id/card_storage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/perm_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/status_dot_storage"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/perm_status_pending" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="10dp"
                        android:text="@string/perm_storage_title"
                        android:textSize="15.5sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/perm_storage_body"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#757575" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/perm_step_1"
                    android:textSize="12.5sp"
                    android:textColor="#9E9E9E" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perm_step_2"
                    android:textSize="12.5sp"
                    android:textColor="#9E9E9E" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_grant_storage"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_accent_pill"
                    android:text="@string/perm_grant_storage"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- Notification permission card -->
            <LinearLayout
                android:id="@+id/card_notif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/perm_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/status_dot_notif"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/perm_status_pending" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="10dp"
                        android:text="@string/perm_notif_title"
                        android:textSize="15.5sp"
                        android:textStyle="bold"
                        android:textColor="#212121" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/perm_notif_body"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#757575" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/perm_step_3"
                    android:textSize="12.5sp"
                    android:textColor="#9E9E9E" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_grant_notif"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_accent_pill"
                    android:text="@string/perm_grant_notif"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_continue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/btn_accent_pill"
            android:text="@string/perm_all_set"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:padding="6dp"
            android:text="@string/perm_skip"
            android:textSize="13sp"
            android:textColor="#9E9E9E" />
    </LinearLayout>

</LinearLayout>
