<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/videoPlayerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true">

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/videoBuffering"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <!-- Tap anywhere on the video to toggle the control overlay; also the
         surface that catches drag gestures for brightness/volume/seek. -->
    <View
        android:id="@+id/videoTapCatcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <!-- ===== Gesture HUD: brightness (left-side vertical drag) ===== -->
    <LinearLayout
        android:id="@+id/hudBrightness"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/gesture_hud_bg"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgHudBrightnessIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_hud_brightness" />

        <ProgressBar
            android:id="@+id/hudBrightnessBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="50" />

        <TextView
            android:id="@+id/txtHudBrightness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="50%"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== Gesture HUD: volume (right-side vertical drag) ===== -->
    <LinearLayout
        android:id="@+id/hudVolume"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/gesture_hud_bg"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgHudVolumeIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_hud_volume" />

        <ProgressBar
            android:id="@+id/hudVolumeBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="50" />

        <TextView
            android:id="@+id/txtHudVolume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="50%"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== Gesture HUD: seek preview (horizontal swipe anywhere) ===== -->
    <LinearLayout
        android:id="@+id/hudSeek"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/gesture_hud_bg"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgHudSeekDirection"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_forward_10" />

        <TextView
            android:id="@+id/txtHudSeek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="0:00 / 0:00"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== Overlay: top bar (back + title + speed) ===== -->
    <LinearLayout
        android:id="@+id/videoTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#99000000"
        android:paddingTop="18dp"
        android:paddingBottom="14dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnVideoBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:tint="#FFFFFF"
            android:contentDescription="Back"
            android:src="@drawable/ic_search_clear" />

        <TextView
            android:id="@+id/txtVideoPlayerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Video title"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnVideoSpeed"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:contentDescription="Playback speed"
            android:src="@drawable/ic_video_speed" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnVideoPip"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:contentDescription="Picture in picture"
            android:src="@drawable/ic_video_pip" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnVideoFullscreen"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:contentDescription="Fullscreen"
            android:src="@drawable/ic_video_fullscreen" />
    </LinearLayout>

    <!-- ===== Overlay: center transport controls ===== -->
    <LinearLayout
        android:id="@+id/videoCenterControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnVideoRewind"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:padding="14dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:contentDescription="Rewind 10 seconds"
            android:src="@drawable/ic_rewind_10" />

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"
            android:background="@drawable/fab_video_bg">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnVideoPlayPause"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:padding="22dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:contentDescription="Play/Pause"
                android:src="@drawable/plays" />
        </FrameLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnVideoForward"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:padding="14dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:contentDescription="Forward 10 seconds"
            android:src="@drawable/ic_forward_10" />
    </LinearLayout>

    <!-- ===== Overlay: bottom seek bar + time ===== -->
    <LinearLayout
        android:id="@+id/videoBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#99000000"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <SeekBar
            android:id="@+id/videoSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtVideoPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="12sp"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/txtVideoSpeedBadge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text=""
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FF80AB" />

            <TextView
                android:id="@+id/txtVideoDurationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="12sp"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- MUZIKI Video's little surprise: a quick confetti burst plays here
         when a video is watched all the way to the end. Sits above every
         other overlay so it's never clipped by the control bars. -->
    <com.mayuto.dev.muziki.ConfettiBurstView
        android:id="@+id/confettiBurst"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

</RelativeLayout>
